{
  "name": "@wayke-se/ecom-web",
  "version": "2.1.4-beta.1",
  "description": "Wayke Ecom Web",
  "type": "module",
  "module": "dist/index.mjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "homepage": "https://github.com/wayke-se/wayke-ecom-web",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wayke-se/wayke-ecom-web.git"
  },
  "scripts": {
    "start": "node ./esbuild/start.js",
    "build": "npm run clean && node ./esbuild/lib.js && node ./esbuild/cdn.js && npm run build:types",
    "build:types": "tsc --project tsconfig.build.json --declaration --emitDeclarationOnly --outDir dist",
    "clean": "rimraf build && rimraf dist && rimraf dist-cdn",
    "test": "npm run lint && npm run typecheck && npm run test:unit",
    "test:unit": "vitest run",
    "typecheck": "tsc -noEmit",
    "typecheck:watch": "tsc -noEmit -watch",
    "lint": "npx @biomejs/biome check",
    "lint:fix": "npx @biomejs/biome check --write",
    "stylelint": "stylelint '**/*.scss'",
    "prepare": "husky"
  },
  "author": "Wayke",
  "license": "ISC",
  "lint-staged": {
    "*.{js,ts}": [
      "npx @biomejs/biome check"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.9",
    "@types/node": "^26.6.11",
    "@types/object-path": "^0.11.4",
    "@types/sanitize-html": "^2.16.2",
    "esbuild": "^0.28.2",
    "esbuild-sass-plugin": "^3.7.0",
    "husky": "^9.1.7",
    "jest-theories": "^1.5.1",
    "jsdom": "^31.0.1",
    "lint-staged": "^17.6.2",
    "rimraf": "^6.1.4",
    "stylelint": "^18.1.0",
    "stylelint-config-prettier-scss": "^1.0.0",
    "stylelint-config-standard-scss": "^18.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.2"
  },
  "dependencies": {
    "i18next": "^27.2.10",
    "marked": "^18.3.0",
    "object-path": "^0.11.8",
    "redux": "^5.0.1",
    "sanitize-html": "^2.18.2"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "volta": {
    "node": "24"
  },
  "allowScripts": {
    "esbuild": false,
    "@parcel/watcher": false,
    "fsevents": false
  }
}
